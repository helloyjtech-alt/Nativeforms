

{% style %}
  .shopify-app-block:has(> #nf-block-{{ block.id }}) {
    width: 100%;
    max-width: var(--nf-wrapper-max-width, 100%);
  }

  #nf-block-{{ block.id }} {
    display: flex;
    flex-direction: column;
    align-items: var(--nf-wrapper-align);
    width: var(--nf-wrapper-width);
    min-width: var(--nf-wrapper-min-width);
    max-width: var(--nf-wrapper-max-width);
    height: var(--nf-wrapper-height);
    min-height: var(--nf-wrapper-min-height);
    max-height: var(--nf-wrapper-max-height);
    margin: var(--nf-wrapper-margin);
    padding: var(--nf-wrapper-padding);
    background-color: var(--nf-wrapper-bg);
    background-image: var(--nf-wrapper-bg-img);
    background-position: var(--nf-wrapper-bg-pos);
    background-size: var(--nf-wrapper-bg-size);
    background-repeat: var(--nf-wrapper-bg-repeat);
    box-sizing: border-box;
    font-family: var(--nf-font-family, inherit);
    font-size: var(--nf-font-size, 16px);
    font-weight: var(--nf-font-weight, 400);
    line-height: var(--nf-line-height, 1.5);
    color: var(--nf-text-color, inherit);
    text-decoration: var(--nf-text-decoration, none);
    direction: var(--nf-direction);
  }

  #nf-block-{{ block.id }} * { box-sizing: border-box; }

  #nf-block-{{ block.id }} .nativeforms-canvas-container {
    width: 100%;
    max-width: var(--nf-max-width);
    min-height: 150px;
    position: relative;
  }

  /* ----- Card / runtime form shell ----- */
  #nf-block-{{ block.id }} .nf-form {
    background-color: var(--nf-container-bg);
    background-image: var(--nf-container-bg-img);
    background-position: center;
    background-size: cover;
    border-style: var(--nf-container-border-style);
    border-color: var(--nf-container-border-color);
    border-width: var(--nf-container-border-width);
    border-radius: var(--nf-container-radius);
    padding: var(--nf-container-padding);
    box-shadow: var(--nf-container-shadow);
    outline-width: var(--nf-container-outline-width);
    outline-style: var(--nf-container-outline-style);
    outline-color: var(--nf-container-outline-color);
    outline-offset: var(--nf-container-outline-offset);
    backdrop-filter: blur(var(--nf-container-blur));
    -webkit-backdrop-filter: blur(var(--nf-container-blur));
    overflow: var(--nf-container-overflow);
    width: var(--nf-container-width);
    min-width: var(--nf-container-min-width);
    max-width: var(--nf-container-max-width);
    min-height: var(--nf-container-min-height);
    max-height: var(--nf-container-max-height);
    box-sizing: border-box;
    animation: nf-form-in 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes nf-form-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ----- Header ----- */
  #nf-block-{{ block.id }} .nf-header {
    text-align: var(--nf-header-align);
    margin-bottom: var(--nf-header-margin-bottom);
    padding: var(--nf-header-padding);
    background: var(--nf-header-bg);
    border-bottom-width: var(--nf-header-border-bottom-width);
    border-bottom-style: var(--nf-header-border-bottom-style);
    border-bottom-color: var(--nf-header-border-bottom-color);
  }
  #nf-block-{{ block.id }} .nf-title {
    font-family: var(--nf-title-font);
    font-size: var(--nf-title-size);
    font-weight: var(--nf-title-weight);
    font-style: var(--nf-title-style);
    color: var(--nf-title-color);
    letter-spacing: var(--nf-title-letter-spacing);
    line-height: var(--nf-title-line-height);
    text-transform: var(--nf-title-transform);
    text-decoration: var(--nf-title-decoration);
    margin: 0 0 var(--nf-title-margin-bottom) 0;
  }
  #nf-block-{{ block.id }} .nf-subtitle {
    font-family: var(--nf-subtitle-font);
    font-size: var(--nf-subtitle-size);
    font-weight: var(--nf-subtitle-weight);
    font-style: var(--nf-subtitle-style);
    color: var(--nf-subtitle-color);
    letter-spacing: var(--nf-subtitle-letter-spacing);
    line-height: var(--nf-subtitle-line-height);
    text-transform: var(--nf-subtitle-transform);
    text-decoration: var(--nf-subtitle-decoration);
    margin: 0;
  }

  /* ----- Field grid ----- */
  #nf-block-{{ block.id }} .nf-grid {
    display: grid;
    grid-template-columns: var(--nf-grid-template, repeat(1, minmax(0, 1fr)));
    row-gap: var(--nf-row-gap);
    column-gap: var(--nf-col-gap);
    width: 100%;
  }
  #nf-block-{{ block.id }} .nf-field {
    display: flex;
    flex-direction: var(--nf-field-direction, column);
    gap: var(--nf-label-gap);
    grid-column: span var(--nf-field-span, 1);
    position: relative;
    width: 100%;
  }
  
  /* Fallback specific spans */
  #nf-block-{{ block.id }} .nf-field[data-width="100"] { grid-column: 1 / -1; }
  #nf-block-{{ block.id }} .nf-field[data-width="75"] { grid-column: span 3; }
  #nf-block-{{ block.id }} .nf-field[data-width="66"] { grid-column: span 2; }
  #nf-block-{{ block.id }} .nf-field[data-width="50"] { grid-column: span var(--nf-span-half, 1); }
  #nf-block-{{ block.id }} .nf-field[data-width="33"] { grid-column: span var(--nf-span-third, 1); }
  #nf-block-{{ block.id }} .nf-field[data-width="25"] { grid-column: span var(--nf-span-quarter, 1); }

  @media (max-width: 640px) {
    #nf-block-{{ block.id }} .nf-grid { grid-template-columns: 1fr; }
    #nf-block-{{ block.id }} .nf-field { grid-column: 1 / -1 !important; }
  }

  /* ----- Label ----- */
  #nf-block-{{ block.id }} .nf-label {
    display: block;
    font-family: var(--nf-label-font-family, inherit);
    font-size: var(--nf-label-font-size);
    font-weight: var(--nf-label-font-weight);
    color: var(--nf-label-color);
    text-transform: var(--nf-label-transform, none);
    letter-spacing: 0.01em;
    flex: none;
    margin-bottom: var(--nf-label-margin-bottom, 4px);
  }
  #nf-block-{{ block.id }} .nf-required {
    color: var(--nf-asterisk-color);
    margin-left: 3px;
  }
  #nf-block-{{ block.id }} .nf-label.nf-sr-only {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap; margin: -1px;
  }

  /* ----- Base control surface (text/email/number/textarea/select trigger) ----- */
  #nf-block-{{ block.id }} .nf-control {
    width: 100%;
    display: block;
    font-family: var(--nf-input-font-family, inherit);
    font-size: var(--nf-input-font-size);
    font-weight: var(--nf-input-font-weight);
    color: var(--nf-input-color);
    background: var(--nf-input-bg);
    border-style: solid;
    border-color: var(--nf-input-border);
    border-width: var(--nf-input-border-width, 1px);
    border-radius: var(--nf-input-radius);
    padding: var(--nf-input-padding);
    height: var(--nf-input-height, auto);
    box-shadow: var(--nf-input-shadow, none);
    transition: border-color var(--nf-transition-duration, 0.2s) ease,
                box-shadow var(--nf-transition-duration, 0.2s) ease,
                background-color var(--nf-transition-duration, 0.2s) ease;
    outline: none;
  }
  #nf-block-{{ block.id }} .nf-input-wrap {
    position: relative;
    width: 100%;
    display: block;
  }
  #nf-block-{{ block.id }} .nf-placeholder {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    padding: var(--nf-input-padding);
    padding-left: var(--nf-input-padding-left, var(--nf-input-padding));
    color: var(--nf-placeholder-color, #94a3b8);
    font-family: var(--nf-placeholder-font-family, inherit);
    font-size: var(--nf-placeholder-font-size, inherit);
    font-weight: var(--nf-placeholder-font-weight, inherit);
    font-style: var(--nf-placeholder-font-style, normal);
    letter-spacing: var(--nf-placeholder-letter-spacing, 0px);
    opacity: var(--nf-placeholder-opacity, 1);
    pointer-events: none;
    transition: all var(--nf-placeholder-animation-duration, 0.2s) var(--nf-placeholder-animation-easing, ease);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    width: 100%;
    height: 100%;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    z-index: 1;
  }
  /* If the input has focus, or has a value (not placeholder-shown), trigger animation */
  /* Fallback: if browser doesn't support placeholder-shown, we use a JS class or just fade */
  #nf-block-{{ block.id }} .nf-control:focus ~ .nf-placeholder,
  #nf-block-{{ block.id }} .nf-control:not(:placeholder-shown) ~ .nf-placeholder {
    /* Using CSS vars for animation styles won't easily map string values to different transforms without a huge hack. */
    /* So we apply default fade, but form-builder-runtime.js will apply a data-anim attribute to .nf-input-wrap. */
  }
  #nf-block-{{ block.id }}[data-ph-anim="fade"] .nf-control:focus ~ .nf-placeholder,
  #nf-block-{{ block.id }}[data-ph-anim="fade"] .nf-control:not(:placeholder-shown) ~ .nf-placeholder {
    opacity: 0;
  }
  #nf-block-{{ block.id }}[data-ph-anim="slide-up"] .nf-control:focus ~ .nf-placeholder,
  #nf-block-{{ block.id }}[data-ph-anim="slide-up"] .nf-control:not(:placeholder-shown) ~ .nf-placeholder {
    transform: translateY(-100%);
    opacity: 0;
  }
  #nf-block-{{ block.id }}[data-ph-anim="slide-right"] .nf-control:focus ~ .nf-placeholder,
  #nf-block-{{ block.id }}[data-ph-anim="slide-right"] .nf-control:not(:placeholder-shown) ~ .nf-placeholder {
    transform: translate(20px, -50%);
    opacity: 0;
  }
  #nf-block-{{ block.id }}[data-ph-anim="none"] .nf-control:focus ~ .nf-placeholder,
  #nf-block-{{ block.id }}[data-ph-anim="none"] .nf-control:not(:placeholder-shown) ~ .nf-placeholder {
    display: none;
  }
  #nf-block-{{ block.id }} .nf-control:hover:not(:disabled):not(:focus) { 
    background: var(--nf-input-hover-bg, var(--nf-input-bg));
    border-color: var(--nf-input-hover-border); 
    box-shadow: var(--nf-input-hover-shadow, var(--nf-input-shadow, none));
  }
  #nf-block-{{ block.id }} .nf-control:focus,
  #nf-block-{{ block.id }} .nf-select-trigger:focus {
    background: var(--nf-input-focus-bg, var(--nf-input-bg));
    border-color: var(--nf-input-focus-border);
    box-shadow: var(--nf-input-focus-shadow, none), 0 0 0 var(--nf-input-focus-ring-width, 3px) var(--nf-input-focus-ring-color, rgba(99,102,241,0.18));
    outline: var(--nf-input-focus-ring-width, 3px) solid transparent;
    outline-offset: var(--nf-input-focus-ring-offset, 0px);
  }
  #nf-block-{{ block.id }} .nf-control:disabled {
    background: var(--nf-input-disabled-bg);
    border-color: var(--nf-input-disabled-border);
    opacity: var(--nf-input-disabled-opacity);
    cursor: not-allowed;
  }
  #nf-block-{{ block.id }} .nf-field[data-error="true"] .nf-control,
  #nf-block-{{ block.id }} .nf-field[data-error="true"] .nf-select-trigger {
    border-color: var(--nf-input-error-border);
    background: var(--nf-input-error-bg);
    color: var(--nf-input-error-color);
  }
  #nf-block-{{ block.id }} textarea.nf-control { resize: vertical; min-height: 96px; line-height: 1.5; }

  /* ----- Help / error text ----- */
  #nf-block-{{ block.id }} .nf-help {
    font-size: var(--nf-help-font-size);
    font-weight: var(--nf-help-font-weight);
    color: var(--nf-help-color);
    margin-top: 6px;
    line-height: var(--nf-help-line-height, 1.4);
  }
  #nf-block-{{ block.id }} .nf-error-msg {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: var(--nf-error-font-size);
    font-weight: var(--nf-error-font-weight);
    color: var(--nf-error-text-color);
    background: var(--nf-error-bg, transparent);
    padding: var(--nf-error-padding, 0px);
    border-radius: var(--nf-error-radius, 0px);
    margin-top: 6px;
    animation: nf-shake-in 0.3s ease;
  }
  @keyframes nf-shake-in {
    0% { opacity: 0; transform: translateY(-3px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  /* ----- Custom Select ----- */
  #nf-block-{{ block.id }} .nf-select {
    position: relative;
  }
  #nf-block-{{ block.id }} .nf-select-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    cursor: pointer;
    user-select: none;
    width: 100%;
    background: var(--nf-select-bg, var(--nf-input-bg));
    color: var(--nf-select-color, var(--nf-input-color));
    border-style: solid;
    border-color: var(--nf-select-border, var(--nf-input-border));
    border-width: var(--nf-select-border-width, var(--nf-input-border-width, 1px));
    border-radius: var(--nf-select-radius, var(--nf-input-radius));
    padding: var(--nf-select-padding, var(--nf-input-padding));
    box-shadow: var(--nf-select-shadow, var(--nf-input-shadow, none));
    font-size: var(--nf-input-font-size);
    font-family: var(--nf-input-font-family, inherit);
    font-weight: var(--nf-input-font-weight);
    transition: border-color var(--nf-transition-duration, 0.2s) ease,
                background-color var(--nf-transition-duration, 0.2s) ease,
                box-shadow var(--nf-transition-duration, 0.2s) ease;
    outline: none;
  }
  #nf-block-{{ block.id }} .nf-select-trigger:hover:not([aria-disabled="true"]) {
    border-color: var(--nf-select-hover-border, var(--nf-input-hover-border));
    background: var(--nf-select-hover-bg, var(--nf-input-hover-bg, var(--nf-input-bg)));
  }
  #nf-block-{{ block.id }} .nf-select-trigger:focus,
  #nf-block-{{ block.id }} .nf-select[data-open="true"] .nf-select-trigger {
    border-color: var(--nf-input-focus-border);
    box-shadow: 0 0 0 var(--nf-input-focus-ring-width, 3px) var(--nf-select-focus-ring, var(--nf-input-focus-ring-color, rgba(99,102,241,0.18)));
  }
  #nf-block-{{ block.id }} .nf-select-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  #nf-block-{{ block.id }} .nf-select-value[data-placeholder="true"] { color: var(--nf-placeholder-color); }
  #nf-block-{{ block.id }} .nf-select-arrow {
    flex: none;
    width: 10px; height: 10px;
    border-right: 1.5px solid var(--nf-select-icon-color, var(--nf-text-secondary, #64748b));
    border-bottom: 1.5px solid var(--nf-select-icon-color, var(--nf-text-secondary, #64748b));
    transform: rotate(45deg);
    transition: transform var(--nf-transition-duration, 0.2s) ease;
    margin-top: -3px;
  }
  #nf-block-{{ block.id }} .nf-select[data-open="true"] .nf-select-arrow { transform: rotate(-135deg); margin-top: 3px; }
  #nf-block-{{ block.id }} .nf-select-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0; right: 0;
    background: var(--nf-panel-bg, var(--nf-select-panel-bg, #ffffff));
    border: var(--nf-panel-border, var(--nf-select-panel-border, 1px solid #e2e8f0));
    border-radius: var(--nf-select-panel-radius, 8px);
    box-shadow: var(--nf-select-panel-shadow, 0 10px 15px -3px rgba(0,0,0,0.1));
    max-height: var(--nf-select-panel-max-height, 240px);
    overflow-y: auto;
    padding: 6px;
    z-index: 40;
    opacity: 0;
    transform: translateY(-6px) scale(0.98);
    pointer-events: none;
    transition: opacity var(--nf-transition-duration, 0.2s) ease, transform var(--nf-transition-duration, 0.2s) ease;
  }
  #nf-block-{{ block.id }} .nf-select[data-open="true"] .nf-select-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }
  #nf-block-{{ block.id }} .nf-option {
    padding: 9px 10px;
    border-radius: 6px;
    font-size: var(--nf-select-option-size, var(--nf-input-font-size));
    color: var(--nf-option-color, var(--nf-select-option-color, var(--nf-input-color, #1e293b)));
    cursor: pointer;
    transition: background-color 0.12s ease;
  }
  #nf-block-{{ block.id }} .nf-option:hover,
  #nf-block-{{ block.id }} .nf-option[data-active="true"] {
    background: var(--nf-option-hover-bg, var(--nf-select-option-hover-bg, #f1f5f9));
    color: var(--nf-select-option-hover-color, var(--nf-input-color, #1e293b));
  }
  #nf-block-{{ block.id }} .nf-option[data-selected="true"] {
    background: var(--nf-option-selected-bg, var(--nf-select-option-selected-bg, #e0e7ff));
    color: var(--nf-select-option-selected-color, #4f46e5);
    font-weight: 600;
  }

  /* ----- Radio / Checkbox groups ----- */
  #nf-block-{{ block.id }} .nf-choice-group {
    display: flex;
    flex-direction: var(--nf-radio-direction, column);
    gap: var(--nf-radio-gap, 12px);
  }
  #nf-block-{{ block.id }} .nf-choice-group[data-type="checkbox"] {
    flex-direction: var(--nf-checkbox-direction, column);
    gap: var(--nf-checkbox-gap, 12px);
  }
  #nf-block-{{ block.id }} .nf-choice-group[data-direction="row"] { flex-direction: row; flex-wrap: wrap; }
  #nf-block-{{ block.id }} .nf-choice {
    display: flex;
    align-items: flex-start;
    gap: var(--nf-radio-label-gap, 8px);
    cursor: pointer;
    font-size: var(--nf-radio-label-size, var(--nf-input-font-size));
    font-weight: var(--nf-radio-label-weight, 400);
    color: var(--nf-radio-label-color, var(--nf-text-color, inherit));
    padding: 8px;
    border: 1px solid transparent;
    border-radius: 6px;
    transition: background-color var(--nf-radio-transition, 0.2s) ease;
  }
  #nf-block-{{ block.id }} .nf-choice-group[data-type="checkbox"] .nf-choice {
    gap: var(--nf-checkbox-label-gap, 8px);
    font-size: var(--nf-checkbox-label-size, var(--nf-input-font-size));
    font-weight: var(--nf-checkbox-label-weight, 400);
    color: var(--nf-checkbox-label-color, var(--nf-text-color, inherit));
    transition: background-color var(--nf-checkbox-transition, 0.2s) ease;
  }
  #nf-block-{{ block.id }} .nf-choice:hover {
    background: var(--nf-radio-hover-bg, transparent);
  }
  #nf-block-{{ block.id }} .nf-choice-group[data-type="checkbox"] .nf-choice:hover {
    background: var(--nf-checkbox-hover-bg, transparent);
  }
  #nf-block-{{ block.id }} .nf-choice:has(input:checked) {
    background: var(--nf-choice-active-bg, transparent);
    border-color: var(--nf-choice-active-border, transparent);
  }
  #nf-block-{{ block.id }} .nf-choice input { position: absolute; opacity: 0; width: 1px; height: 1px; }
  #nf-block-{{ block.id }} .nf-choice-box {
    flex: none;
    width: var(--nf-radio-size, 18px);
    height: var(--nf-radio-size, 18px);
    border: 1.5px solid var(--nf-radio-unchecked-border, #cbd5e1);
    background: var(--nf-radio-unchecked-bg, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--nf-radio-transition, 0.2s) ease;
    margin-top: 1px;
  }
  #nf-block-{{ block.id }} .nf-choice-box.nf-check-box {
    width: var(--nf-checkbox-size, 18px);
    height: var(--nf-checkbox-size, 18px);
    border-color: var(--nf-checkbox-unchecked-border, #cbd5e1);
    background: var(--nf-checkbox-unchecked-bg, #ffffff);
    border-radius: var(--nf-checkbox-radius, 4px);
    transition: all var(--nf-checkbox-transition, 0.2s) ease;
  }
  #nf-block-{{ block.id }} .nf-choice-box.nf-radio-box { border-radius: 50%; }
  #nf-block-{{ block.id }} .nf-choice input:focus-visible ~ .nf-choice-box {
    box-shadow: 0 0 0 var(--nf-input-focus-ring-width, 3px) var(--nf-radio-focus-ring, rgba(99,102,241,0.2));
  }
  #nf-block-{{ block.id }} .nf-choice-group[data-type="checkbox"] .nf-choice input:focus-visible ~ .nf-choice-box {
    box-shadow: 0 0 0 var(--nf-input-focus-ring-width, 3px) var(--nf-checkbox-focus-ring, rgba(99,102,241,0.2));
  }
  #nf-block-{{ block.id }} .nf-choice:hover .nf-radio-box { border-color: var(--nf-radio-hover-border, var(--nf-radio-checked-border, #6366f1)); }
  #nf-block-{{ block.id }} .nf-choice:hover .nf-check-box { border-color: var(--nf-checkbox-hover-border, var(--nf-checkbox-checked-border, #6366f1)); }
  #nf-block-{{ block.id }} .nf-choice:active .nf-radio-box { 
    background: var(--nf-radio-active-bg, var(--nf-radio-unchecked-bg, #f1f5f9));
    transform: scale(0.95);
  }
  #nf-block-{{ block.id }} .nf-choice:active .nf-check-box { 
    background: var(--nf-checkbox-active-bg, var(--nf-checkbox-unchecked-bg, #f1f5f9));
    transform: scale(0.95);
  }
  #nf-block-{{ block.id }} .nf-choice input:checked ~ .nf-radio-box {
    background: var(--nf-radio-checked-bg, #6366f1);
    border-color: var(--nf-radio-checked-border, #6366f1);
    transform: scale(1.04);
  }
  #nf-block-{{ block.id }} .nf-choice input:checked ~ .nf-check-box {
    background: var(--nf-checkbox-checked-bg, #6366f1);
    border-color: var(--nf-checkbox-checked-border, #6366f1);
    transform: scale(1.04);
  }
  #nf-block-{{ block.id }} .nf-choice-box svg { width: 60%; height: 60%; opacity: 0; transform: scale(0.5); transition: all 0.15s ease; }
  #nf-block-{{ block.id }} .nf-choice-box.nf-radio-box::after {
    content: ''; width: 42%; height: 42%; border-radius: 50%;
    background: var(--nf-radio-dot-color, #ffffff);
    opacity: 0; transform: scale(0.4); transition: all 0.15s ease;
  }
  #nf-block-{{ block.id }} .nf-choice input:checked ~ .nf-radio-box::after { opacity: 1; transform: scale(1); }
  #nf-block-{{ block.id }} .nf-choice input:checked ~ .nf-check-box svg {
    opacity: 1; transform: scale(1);
    stroke: var(--nf-checkbox-check-color, #ffffff);
  }
  #nf-block-{{ block.id }} .nf-choice-label { line-height: var(--nf-radio-size, 18px); }
  #nf-block-{{ block.id }} .nf-choice-group[data-type="checkbox"] .nf-choice-label { line-height: var(--nf-checkbox-size, 18px); }

  /* ----- Rating ----- */
  #nf-block-{{ block.id }} .nf-rating {
    display: flex;
    gap: var(--nf-rating-gap, 4px);
  }
  #nf-block-{{ block.id }} .nf-rating-star {
    width: var(--nf-rating-size, 24px);
    height: var(--nf-rating-size, 24px);
    cursor: pointer;
    fill: none;
    stroke: var(--nf-rating-unselected, #cbd5e1);
    stroke-width: 1.5px;
    transition: transform var(--nf-rating-transition, 0.2s) ease,
                fill var(--nf-rating-transition, 0.2s) ease,
                stroke var(--nf-rating-transition, 0.2s) ease;
  }
  #nf-block-{{ block.id }} .nf-rating-star:hover {
    fill: var(--nf-rating-hover, #facc15);
    stroke: var(--nf-rating-hover, #facc15);
    transform: scale(1.12);
  }
  #nf-block-{{ block.id }} .nf-rating-star:active {
    fill: var(--nf-rating-active, var(--nf-rating-selected, #ca8a04));
    stroke: var(--nf-rating-active, var(--nf-rating-selected, #ca8a04));
    transform: scale(0.95);
  }
  #nf-block-{{ block.id }} .nf-rating-star.nf-active {
    fill: var(--nf-rating-selected, #eab308);
    stroke: var(--nf-rating-selected, #eab308);
    transform: scale(1.08);
  }

  /* ----- File upload ----- */
  #nf-block-{{ block.id }} .nf-dropzone {
    border: var(--nf-file-border, 2px dashed #cbd5e1);
    border-radius: var(--nf-file-radius, 8px);
    background: var(--nf-file-bg, #f8fafc);
    height: var(--nf-file-height, auto);
    min-height: 100px;
    padding: 28px 16px;
    text-align: center;
    cursor: pointer;
    transition: all var(--nf-transition-duration, 0.2s) ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  #nf-block-{{ block.id }} .nf-dropzone:hover {
    border-color: var(--nf-file-active-border, #38bdf8);
    background: var(--nf-file-active-bg, #f0f9ff);
  }
  #nf-block-{{ block.id }} .nf-dropzone[data-dragover="true"] {
    border-color: var(--nf-file-active-border, #38bdf8);
    background: var(--nf-file-active-bg, #f0f9ff);
  }
  #nf-block-{{ block.id }} .nf-dropzone svg {
    width: var(--nf-file-icon-size, 24px);
    height: var(--nf-file-icon-size, 24px);
    stroke: var(--nf-file-icon-color, #94a3b8);
    margin-bottom: 4px;
  }
  #nf-block-{{ block.id }} .nf-dropzone-text {
    font-size: 13px;
    color: var(--nf-file-text-color, #64748b);
  }
  #nf-block-{{ block.id }} .nf-dropzone-text strong { color: var(--nf-input-focus-border, #6366f1); font-weight: 600; }
  #nf-block-{{ block.id }} .nf-file-chip {
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--nf-file-chip-bg, #f1f5f9);
    color: var(--nf-file-chip-color, #334155);
    border-radius: var(--nf-file-chip-radius, 4px);
    padding: 6px 10px 6px 12px;
    font-size: 13px; margin-top: 10px;
  }
  #nf-block-{{ block.id }} .nf-file-chip button {
    background: none; border: none; cursor: pointer;
    color: var(--nf-file-remove-color, #ef4444);
    width: 18px; height: 18px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
  }
  #nf-block-{{ block.id }} .nf-file-chip button:hover { background: rgba(0,0,0,0.08); }

  /* ----- Submit / navigation button ----- */
  #nf-block-{{ block.id }} .nf-actions { display: flex; margin-top: 8px; }
  #nf-block-{{ block.id }} .nf-actions[data-align="left"] { justify-content: flex-start; }
  #nf-block-{{ block.id }} .nf-actions[data-align="center"] { justify-content: center; }
  #nf-block-{{ block.id }} .nf-actions[data-align="right"] { justify-content: flex-end; }
  #nf-block-{{ block.id }} .nf-actions[data-align="stretch"] { justify-content: stretch; }
  #nf-block-{{ block.id }} .nf-submit {
    width: var(--nf-submit-width, var(--nf-btn-width, auto));
    min-width: var(--nf-submit-min-width, none);
    height: var(--nf-submit-height, auto);
    font-family: var(--nf-submit-font-family, inherit);
    font-size: var(--nf-submit-font-size, var(--nf-btn-font-size));
    font-weight: var(--nf-submit-font-weight, var(--nf-btn-weight, 600));
    letter-spacing: var(--nf-submit-letter-spacing, 0px);
    text-transform: var(--nf-submit-text-transform, none);
    color: var(--nf-submit-color, var(--nf-btn-text, #ffffff));
    background: var(--nf-submit-bg, var(--nf-btn-bg, #000000));
    border: var(--nf-submit-border, none);
    border-radius: var(--nf-submit-radius, var(--nf-btn-radius, 8px));
    padding: var(--nf-submit-padding, var(--nf-btn-padding, 13px 32px));
    box-shadow: var(--nf-submit-shadow, var(--nf-btn-shadow));
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transition: background-color var(--nf-submit-transition-duration, var(--nf-transition-duration, 0.2s)) var(--nf-submit-transition-easing, ease),
                color var(--nf-submit-transition-duration, var(--nf-transition-duration, 0.2s)) var(--nf-submit-transition-easing, ease),
                box-shadow var(--nf-submit-transition-duration, var(--nf-transition-duration, 0.2s)) var(--nf-submit-transition-easing, ease),
                border-color var(--nf-submit-transition-duration, var(--nf-transition-duration, 0.2s)) var(--nf-submit-transition-easing, ease),
                transform var(--nf-submit-transition-duration, var(--nf-transition-duration, 0.2s)) var(--nf-submit-transition-easing, ease);
  }
  #nf-block-{{ block.id }} .nf-submit:hover:not(:disabled) {
    background: var(--nf-submit-hover-bg, var(--nf-btn-hover-bg));
    border-color: var(--nf-submit-hover-border, transparent);
    color: var(--nf-submit-hover-color, var(--nf-btn-hover-text));
    box-shadow: var(--nf-submit-hover-shadow, var(--nf-btn-hover-shadow));
    transform: var(--nf-submit-hover-transform-css, none);
  }
  #nf-block-{{ block.id }} .nf-submit:active:not(:disabled) {
    background: var(--nf-submit-active-bg, var(--nf-submit-bg));
    transform: var(--nf-submit-active-transform-css, scale(0.97));
  }
  #nf-block-{{ block.id }} .nf-submit:disabled { 
    background: var(--nf-submit-disabled-bg, #e2e8f0);
    opacity: var(--nf-submit-disabled-opacity, 0.7); 
    cursor: not-allowed; 
  }
  #nf-block-{{ block.id }} .nf-spinner {
    width: 15px; height: 15px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.4); border-top-color: var(--nf-spinner-color, currentColor);
    animation: nf-spin 0.7s linear infinite;
  }
  @keyframes nf-spin { to { transform: rotate(360deg); } }

  /* ----- Success message ----- */
  #nf-block-{{ block.id }} .nf-success {
    background: var(--nf-success-bg, #f0fdf4);
    border: var(--nf-success-border, 1px solid #bbf7d0);
    border-radius: var(--nf-success-radius, 12px);
    padding: var(--nf-success-padding, 24px 32px);
    box-shadow: var(--nf-success-shadow, none);
    text-align: var(--nf-success-text-align, center);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  #nf-block-{{ block.id }} .nf-success[data-animation="fade"] { animation: nf-fade-in var(--nf-success-animation-duration, 0.4s) ease; }
  #nf-block-{{ block.id }} .nf-success[data-animation="slide-down"] { animation: nf-slide-down var(--nf-success-animation-duration, 0.4s) ease; }
  #nf-block-{{ block.id }} .nf-success[data-animation="scale-up"] { animation: nf-scale-in var(--nf-success-animation-duration, 0.4s) cubic-bezier(0.16, 1, 0.3, 1); }
  #nf-block-{{ block.id }} .nf-success-icon {
    width: var(--nf-success-icon-size, 48px);
    height: var(--nf-success-icon-size, 48px);
    stroke: var(--nf-success-icon-color, #16a34a);
    fill: none;
    stroke-width: 1.5;
  }
  #nf-block-{{ block.id }} .nf-success .nf-success-title {
    font-family: var(--nf-success-title-font, inherit);
    color: var(--nf-success-title-color, #166534);
    font-size: var(--nf-success-title-size, 24px);
    font-weight: var(--nf-success-title-weight, 600);
    margin: 0;
  }
  #nf-block-{{ block.id }} .nf-success .nf-success-body {
    font-family: var(--nf-success-body-font, inherit);
    color: var(--nf-success-body-color, #15803d);
    font-size: var(--nf-success-body-size, 16px);
    margin: 0;
  }
  /* Legacy span/p in success block */
  #nf-block-{{ block.id }} .nf-success > span {
    font-family: var(--nf-success-title-font, inherit);
    color: var(--nf-success-title-color, #166534);
    font-size: var(--nf-success-title-size, 24px);
    font-weight: var(--nf-success-title-weight, 600);
  }
  #nf-block-{{ block.id }} .nf-success > p {
    font-family: var(--nf-success-body-font, inherit);
    color: var(--nf-success-body-color, #15803d);
    font-size: var(--nf-success-body-size, 16px);
  }
  #nf-block-{{ block.id }} .nf-success svg.nf-success-icon { width: var(--nf-success-icon-size, 48px); height: var(--nf-success-icon-size, 48px); stroke: var(--nf-success-icon-color, #16a34a); }
  @keyframes nf-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes nf-slide-down {
    from { opacity: 0; transform: translateY(-12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes nf-scale-in {
    from { opacity: 0; transform: scale(0.92); }
    to   { opacity: 1; transform: scale(1); }
  }

  /* ── Multi-Step: progress ── */
  #nf-block-{{ block.id }} .nf-progress { width: 100%; margin-bottom: 28px; }
  #nf-block-{{ block.id }} .nf-step-title {
    font-size: 22px; font-weight: 700; color: var(--nf-title-color);
    margin: 0 0 6px 0; line-height: 1.3;
  }
  #nf-block-{{ block.id }} .nf-step-desc {
    font-size: 14px; color: var(--nf-text-secondary); margin: 0 0 20px 0;
  }
  /* ── Multi-Step: nav buttons ── */
  #nf-block-{{ block.id }} .nf-step-nav { display: flex; padding-top: 20px; margin-top: 24px; border-top: 1px solid var(--nf-input-border); }
  #nf-block-{{ block.id }} .nf-back-btn {
    background: var(--nf-step-back-bg, #e2e8f0);
    color: var(--nf-step-back-color, #334155);
    transition: background-color var(--nf-transition-duration, 0.2s) ease;
  }
  #nf-block-{{ block.id }} .nf-back-btn:hover { background: var(--nf-step-back-hover-bg, var(--nf-step-back-bg, #cbd5e1)); }
  #nf-block-{{ block.id }} .nf-continue-btn:hover { filter: brightness(1.1); transform: translateY(-1px); }
  /* ── Multi-Step: progress bar ── */
  #nf-block-{{ block.id }} .nf-progress-bar-track {
    width: 100%;
    height: var(--nf-step-track-height, 4px);
    background: var(--nf-step-track-color, #e2e8f0);
    border-radius: var(--nf-step-track-radius, 4px);
    overflow: hidden;
    margin-bottom: 20px;
  }
  #nf-block-{{ block.id }} .nf-progress-bar-fill {
    height: 100%;
    background: var(--nf-step-fill-color, #7c3aed);
    border-radius: var(--nf-step-fill-radius, 4px);
    transition: width var(--nf-step-fill-transition, 0.3s) ease;
  }
  #nf-block-{{ block.id }} .nf-step-counter {
    font-size: var(--nf-step-counter-size, 14px);
    color: var(--nf-step-counter-color, #7c3aed);
    font-weight: 600;
    margin-bottom: 16px;
  }
  /* ── Slide transition helper ── */
  #nf-block-{{ block.id }} .nativeforms-canvas-container { position: relative; }

  /* Honeypot */
  #nf-block-{{ block.id }} .nf-hp { position: absolute !important; left: -9999px !important; width: 1px; height: 1px; overflow: hidden; }

  @media (prefers-reduced-motion: reduce) {
    #nf-block-{{ block.id }} * { animation: none !important; transition: none !important; }
  }

  /* Responsive Fallbacks */
  @media (max-width: 768px) {
    #nf-block-{{ block.id }} {
      --nf-wrapper-padding: var(--nf-wrapper-padding-mobile, var(--nf-wrapper-padding)) !important;
      --nf-wrapper-margin: var(--nf-wrapper-margin-mobile, var(--nf-wrapper-margin)) !important;
      --nf-wrapper-width: var(--nf-wrapper-width-mobile, var(--nf-wrapper-width)) !important;
      --nf-wrapper-min-width: var(--nf-wrapper-min-width-mobile, var(--nf-wrapper-min-width)) !important;
      --nf-wrapper-max-width: var(--nf-wrapper-max-width-mobile, var(--nf-wrapper-max-width)) !important;
      --nf-wrapper-height: var(--nf-wrapper-height-mobile, var(--nf-wrapper-height)) !important;
      --nf-wrapper-min-height: var(--nf-wrapper-min-height-mobile, var(--nf-wrapper-min-height)) !important;
      --nf-wrapper-max-height: var(--nf-wrapper-max-height-mobile, var(--nf-wrapper-max-height)) !important;
      
      --nf-padding: var(--nf-padding-mobile, var(--nf-padding)) !important;
      --nf-radius: var(--nf-radius-mobile, var(--nf-radius)) !important;
      --nf-container-border-width: var(--nf-container-border-width-mobile, var(--nf-container-border-width)) !important;
      --nf-container-outline-width: var(--nf-container-outline-width-mobile, var(--nf-container-outline-width)) !important;
      --nf-container-outline-offset: var(--nf-container-outline-offset-mobile, var(--nf-container-outline-offset)) !important;
      --nf-container-width: var(--nf-container-width-mobile, var(--nf-container-width)) !important;
      --nf-container-min-width: var(--nf-container-min-width-mobile, var(--nf-container-min-width)) !important;
      --nf-container-max-width: var(--nf-container-max-width-mobile, var(--nf-container-max-width)) !important;
      --nf-container-min-height: var(--nf-container-min-height-mobile, var(--nf-container-min-height)) !important;
      --nf-container-max-height: var(--nf-container-max-height-mobile, var(--nf-container-max-height)) !important;

      --nf-header-padding: var(--nf-header-padding-mobile, var(--nf-header-padding)) !important;
      --nf-header-border-bottom-width: var(--nf-header-border-bottom-width-mobile, var(--nf-header-border-bottom-width)) !important;
      --nf-title-size: var(--nf-title-size-mobile, var(--nf-title-size)) !important;
      --nf-title-letter-spacing: var(--nf-title-letter-spacing-mobile, var(--nf-title-letter-spacing)) !important;
      --nf-title-line-height: var(--nf-title-line-height-mobile, var(--nf-title-line-height)) !important;
      --nf-title-margin-bottom: var(--nf-title-margin-bottom-mobile, var(--nf-title-margin-bottom)) !important;
      --nf-subtitle-size: var(--nf-subtitle-size-mobile, var(--nf-subtitle-size)) !important;
      --nf-subtitle-letter-spacing: var(--nf-subtitle-letter-spacing-mobile, var(--nf-subtitle-letter-spacing)) !important;
      --nf-subtitle-line-height: var(--nf-subtitle-line-height-mobile, var(--nf-subtitle-line-height)) !important;

      --nf-gap: var(--nf-gap-mobile, var(--nf-gap)) !important;
      --nf-row-gap: var(--nf-row-gap-mobile, var(--nf-row-gap)) !important;
      --nf-label-gap: var(--nf-label-gap-mobile, var(--nf-label-gap)) !important;

      --nf-font-size: var(--nf-font-size-mobile, var(--nf-font-size)) !important;
      --nf-line-height: var(--nf-line-height-mobile, var(--nf-line-height)) !important;
      --nf-label-font-size: var(--nf-label-font-size-mobile, var(--nf-label-font-size)) !important;
      --nf-label-letter-spacing: var(--nf-label-letter-spacing-mobile, var(--nf-label-letter-spacing)) !important;
      --nf-help-font-size: var(--nf-help-font-size-mobile, var(--nf-help-font-size)) !important;

      --nf-input-border-width: var(--nf-input-border-width-mobile, var(--nf-input-border-width)) !important;
      --nf-input-radius: var(--nf-input-radius-mobile, var(--nf-input-radius)) !important;
      --nf-input-padding: var(--nf-input-padding-mobile, var(--nf-input-padding)) !important;
      --nf-input-height: var(--nf-input-height-mobile, var(--nf-input-height)) !important;
      --nf-input-min-height: var(--nf-input-min-height-mobile, var(--nf-input-min-height)) !important;
      --nf-input-max-height: var(--nf-input-max-height-mobile, var(--nf-input-max-height)) !important;
      --nf-input-width: var(--nf-input-width-mobile, var(--nf-input-width)) !important;
      --nf-input-min-width: var(--nf-input-min-width-mobile, var(--nf-input-min-width)) !important;
      --nf-input-max-width: var(--nf-input-max-width-mobile, var(--nf-input-max-width)) !important;
      --nf-input-font-size: var(--nf-input-font-size-mobile, var(--nf-input-font-size)) !important;
      --nf-input-outline-width: var(--nf-input-outline-width-mobile, var(--nf-input-outline-width)) !important;
      --nf-input-outline-offset: var(--nf-input-outline-offset-mobile, var(--nf-input-outline-offset)) !important;
      --nf-input-focus-ring-width: var(--nf-input-focus-ring-width-mobile, var(--nf-input-focus-ring-width)) !important;
      --nf-input-focus-ring-offset: var(--nf-input-focus-ring-offset-mobile, var(--nf-input-focus-ring-offset)) !important;
      
      --nf-placeholder-font-size: var(--nf-placeholder-font-size-mobile, var(--nf-placeholder-font-size)) !important;
      --nf-placeholder-letter-spacing: var(--nf-placeholder-letter-spacing-mobile, var(--nf-placeholder-letter-spacing)) !important;
    }
  }

  /* Dark Mode Fallbacks */
  @media (prefers-color-scheme: dark) {
    #nf-block-{{ block.id }} {
      --nf-wrapper-bg: var(--nf-wrapper-bg-dark, var(--nf-wrapper-bg)) !important;
      --nf-container-bg: var(--nf-container-bg-dark, var(--nf-container-bg)) !important;
      --nf-container-border-color: var(--nf-container-border-color-dark, var(--nf-container-border-color)) !important;
      --nf-container-outline-color: var(--nf-container-outline-color-dark, var(--nf-container-outline-color)) !important;
      --nf-header-bg: var(--nf-header-bg-dark, var(--nf-header-bg)) !important;
      --nf-header-border-bottom-color: var(--nf-header-border-bottom-color-dark, var(--nf-header-border-bottom-color)) !important;
      --nf-title-color: var(--nf-title-color-dark, var(--nf-title-color)) !important;
      --nf-subtitle-color: var(--nf-subtitle-color-dark, var(--nf-subtitle-color)) !important;
      --nf-text-color: var(--nf-text-color-dark, var(--nf-text-color)) !important;
      --nf-label-color: var(--nf-label-color-dark, var(--nf-label-color)) !important;
      --nf-asterisk-color: var(--nf-asterisk-color-dark, var(--nf-asterisk-color)) !important;
      --nf-help-color: var(--nf-help-color-dark, var(--nf-help-color)) !important;
      
      --nf-input-bg: var(--nf-input-bg-dark, var(--nf-input-bg)) !important;
      --nf-input-border: var(--nf-input-border-dark, var(--nf-input-border)) !important;
      --nf-input-color: var(--nf-input-color-dark, var(--nf-input-color)) !important;
      --nf-input-outline-color: var(--nf-input-outline-color-dark, var(--nf-input-outline-color)) !important;
      --nf-input-hover-bg: var(--nf-input-hover-bg-dark, var(--nf-input-hover-bg)) !important;
      --nf-input-hover-border: var(--nf-input-hover-border-dark, var(--nf-input-hover-border)) !important;
      --nf-input-hover-color: var(--nf-input-hover-color-dark, var(--nf-input-hover-color)) !important;
      --nf-input-hover-outline-color: var(--nf-input-hover-outline-color-dark, var(--nf-input-hover-outline-color)) !important;
      --nf-input-focus-bg: var(--nf-input-focus-bg-dark, var(--nf-input-focus-bg)) !important;
      --nf-input-focus-border: var(--nf-input-focus-border-dark, var(--nf-input-focus-border)) !important;
      --nf-input-focus-color: var(--nf-input-focus-color-dark, var(--nf-input-focus-color)) !important;
      --nf-input-focus-outline-color: var(--nf-input-focus-outline-color-dark, var(--nf-input-focus-outline-color)) !important;
      --nf-input-focus-ring-color: var(--nf-input-focus-ring-color-dark, var(--nf-input-focus-ring-color)) !important;
      --nf-input-error-bg: var(--nf-input-error-bg-dark, var(--nf-input-error-bg)) !important;
      --nf-input-error-border: var(--nf-input-error-border-dark, var(--nf-input-error-border)) !important;
      --nf-input-error-color: var(--nf-input-error-color-dark, var(--nf-input-error-color)) !important;
      --nf-input-error-outline-color: var(--nf-input-error-outline-color-dark, var(--nf-input-error-outline-color)) !important;
      --nf-input-disabled-bg: var(--nf-input-disabled-bg-dark, var(--nf-input-disabled-bg)) !important;
      --nf-input-disabled-border: var(--nf-input-disabled-border-dark, var(--nf-input-disabled-border)) !important;
      --nf-input-disabled-color: var(--nf-input-disabled-color-dark, var(--nf-input-disabled-color)) !important;
      --nf-placeholder-color: var(--nf-placeholder-color-dark, var(--nf-placeholder-color)) !important;
    }
  }
{% endstyle %}

<div
  id="nf-block-{{ block.id }}"
  class="nativeforms-app-block"
  data-form-id="{{ block.settings.form_id }}"
  data-design-mode="{% if request.design_mode %}true{% else %}false{% endif %}"
  data-shop="{{ shop.permanent_domain }}"
  style="width: 100%; display: block; flex: 1 1 100%; max-width: 100%; box-sizing: border-box;"
  {{ block.shopify_attributes }}
>
  <div class="nativeforms-canvas-container">
    <!-- Runtime JS will inject the form here -->
  </div>
</div>
<script src="{{ 'form-builder-runtime.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "NativeForms",
  "target": "section",
  "settings": [
    {
      "type": "text",
